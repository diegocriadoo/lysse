{
  "name": "cartooncorp-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Propuesta de rediseño de la tienda online de CartoonCorp — demo independiente",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:single": "vite build --mode single && node scripts/inline.mjs",
    "build:neutral": "npm run build:single && node scripts/neutral.mjs",
    "fotos:informe": "node scripts/fotos-informe.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
