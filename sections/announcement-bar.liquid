{%- if section.blocks.size > 0 -%}
  <div class="announcement" role="region" aria-label="{{ 'general.announcement' | t }}">
    <div class="container announcement__inner">
      {%- for block in section.blocks -%}
        <p class="announcement__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncios",
  "tag": "div",
  "blocks": [
    {
      "type": "message",
      "name": "Mensaje",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío a toda España" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [ { "name": "Barra de anuncios" } ]
}
{% endschema %}
