{%- comment -%}
  Antes / después con comparador deslizante.
  Solo se muestra a los clientes cuando hay dos fotos reales subidas.
  Estilos y script incluidos aquí para no depender del CSS global.
{%- endcomment -%}
{%- liquid
  assign before_img = section.settings.before_image
  assign after_img = section.settings.after_image
  assign ready = false
  if before_img != blank and after_img != blank
    assign ready = true
  endif
-%}

{%- if ready or request.design_mode -%}
<section class="ba section{% if section.settings.tinted %} section--mist{% endif %}" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <header class="section-head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    </header>

    {%- if ready -%}
      <div class="ba__frame" data-ba style="--pos: {{ section.settings.start }}%; aspect-ratio: {{ after_img.aspect_ratio | default: 0.8 }};" data-reveal>
        <img class="ba__img"
             src="{{ after_img | image_url: width: 1200 }}"
             srcset="{{ after_img | image_url: width: 600 }} 600w, {{ after_img | image_url: width: 1200 }} 1200w"
             sizes="(min-width: 900px) 720px, 100vw"
             width="{{ after_img.width }}" height="{{ after_img.height }}"
             alt="{{ after_img.alt | default: section.settings.after_label | escape }}" loading="lazy" decoding="async">
        <div class="ba__before" aria-hidden="true">
          <img class="ba__img"
               src="{{ before_img | image_url: width: 1200 }}"
               srcset="{{ before_img | image_url: width: 600 }} 600w, {{ before_img | image_url: width: 1200 }} 1200w"
               sizes="(min-width: 900px) 720px, 100vw"
               width="{{ before_img.width }}" height="{{ before_img.height }}"
               alt="" loading="lazy" decoding="async">
        </div>
        <span class="ba__tag ba__tag--before">{{ section.settings.before_label }}</span>
        <span class="ba__tag ba__tag--after">{{ section.settings.after_label }}</span>
        <span class="ba__handle" aria-hidden="true"><span></span></span>
        <label class="visually-hidden" for="BA-{{ section.id }}">{{ section.settings.slider_label }}</label>
        <input class="ba__range" id="BA-{{ section.id }}" type="range" min="0" max="100" value="{{ section.settings.start }}"
               aria-valuetext="{{ section.settings.start }}% {{ section.settings.before_label | escape }}">
      </div>
      <p class="visually-hidden">{{ section.settings.before_label }}: {{ before_img.alt | default: 'foto del cabello antes de usar el cepillo' }}.</p>
    {%- else -%}
      <div class="ba__empty">
        <strong>Sube dos fotos reales para activar esta sección</strong>
        <p>Usa «Foto antes» y «Foto después» en el panel de la izquierda: misma persona, misma luz, mismo encuadre y sin retoques. Mientras falte alguna, esta sección no se muestra a los clientes.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.caption != blank -%}
      <p class="ba__caption">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .ba__frame { position: relative; max-width: 720px; margin: 0 auto; border-radius: var(--radius-l, 28px); overflow: hidden; background: #0c0814; box-shadow: 0 30px 60px -30px rgba(40, 20, 70, .45); touch-action: pan-y; user-select: none; }
  .ba__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .ba__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__tag { position: absolute; top: 14px; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #fff; background: rgba(12, 8, 20, .62); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); pointer-events: none; }
  .ba__tag--before { left: 14px; }
  .ba__tag--after { right: 14px; background: var(--accent, #7c3aed); }
  .ba__handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; pointer-events: none; box-shadow: 0 0 12px rgba(0,0,0,.35); }
  .ba__handle span { position: absolute; top: 50%; left: 50%; width: 46px; height: 46px; margin: -23px 0 0 -23px; border-radius: 50%; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,.35); }
  .ba__handle span::before, .ba__handle span::after { content: ""; position: absolute; top: 50%; width: 0; height: 0; margin-top: -6px; border: 6px solid transparent; }
  .ba__handle span::before { left: 9px; border-right-color: var(--accent, #7c3aed); }
  .ba__handle span::after { right: 9px; border-left-color: var(--accent, #7c3aed); }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .ba__range:focus-visible ~ .ba__handle span, .ba__frame:has(.ba__range:focus-visible) .ba__handle span { outline: 3px solid var(--accent, #7c3aed); outline-offset: 3px; }
  .ba__caption { max-width: 720px; margin: 14px auto 0; text-align: center; font-size: var(--fs-sm, .875rem); color: var(--muted, #5f566d); }
  .ba__empty { max-width: 720px; margin: 0 auto; padding: 40px 24px; text-align: center; border: 2px dashed color-mix(in srgb, var(--accent, #7c3aed) 35%, #e7e0f0); border-radius: var(--radius-l, 28px); background: #fff; }
  .ba__empty p { margin-top: 8px; color: var(--muted, #5f566d); }
</style>

<script>
  (() => {
    const init = (root) => root.querySelectorAll('[data-ba]').forEach((frame) => {
      if (frame.dataset.baReady) return;
      frame.dataset.baReady = '1';
      const range = frame.querySelector('.ba__range');
      const set = (v) => {
        frame.style.setProperty('--pos', v + '%');
        range.setAttribute('aria-valuetext', v + '%');
      };
      range.addEventListener('input', () => set(range.value));
    });
    init(document);
    document.addEventListener('shopify:section:load', (e) => init(e.target));
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Antes y después",
  "settings": [
    { "type": "paragraph", "content": "Usa solo fotos reales del mismo cabello antes y después de usar el producto, con la misma luz y encuadre y sin retoques. La sección no se muestra a los clientes hasta que subas las dos fotos." },
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "resultados" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Resultados" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Antes y después <em>de una pasada</em>" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Desliza para comparar." },
    { "type": "image_picker", "id": "before_image", "label": "Foto antes" },
    { "type": "image_picker", "id": "after_image", "label": "Foto después", "info": "Mismo tamaño y proporción que la foto de antes." },
    { "type": "text", "id": "before_label", "label": "Etiqueta antes", "default": "Antes" },
    { "type": "text", "id": "after_label", "label": "Etiqueta después", "default": "Después" },
    { "type": "range", "id": "start", "label": "Posición inicial del deslizador", "min": 10, "max": 90, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "slider_label", "label": "Texto accesible del deslizador", "default": "Desliza para comparar antes y después" },
    { "type": "text", "id": "caption", "label": "Nota bajo la imagen", "default": "Foto real sin retoques. Los resultados pueden variar según el tipo de cabello." },
    { "type": "checkbox", "id": "tinted", "label": "Fondo lavanda", "default": false }
  ],
  "presets": [ { "name": "Antes y después" } ]
}
{% endschema %}
