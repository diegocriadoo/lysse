<section class="section" id="{{ section.settings.anchor | default: section.id }}" aria-labelledby="Heading-{{ section.id }}">
  <div class="container faq-grid">
    <div class="faq-aside" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2" id="Heading-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
      <div class="faq-contact">
        <p>{{ section.settings.contact_text }}</p>
        {%- if settings.contact_email != blank -%}
          <a class="link-arrow" href="mailto:{{ settings.contact_email }}">{% render 'icon', name: 'mail' %}{{ settings.contact_email }}</a>
        {%- else -%}
          <span class="placeholder-note">[Añade tu email de contacto en Ajustes del tema]</span>
        {%- endif -%}
      </div>
    </div>

    <div class="faq-list" data-reveal style="--reveal-delay: 80ms">
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary>
            <span class="summary-title">{{ block.settings.question }}</span>
            <span class="accordion__plus" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Preguntas frecuentes",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Ancla (id)", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "FAQ" },
    { "type": "inline_richtext", "id": "heading", "label": "Título", "default": "Resolvemos <em>tus dudas</em>" },
    { "type": "textarea", "id": "text", "label": "Texto" },
    { "type": "text", "id": "contact_text", "label": "Texto de contacto", "default": "¿No encuentras tu respuesta? Escríbenos y te contestamos personalmente." },
    { "type": "checkbox", "id": "schema", "label": "Añadir datos estructurados FAQ", "default": false, "info": "Actívalo cuando todas las respuestas estén completas (sin textos pendientes)." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Pregunta" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "Preguntas frecuentes" } ]
}
{% endschema %}
