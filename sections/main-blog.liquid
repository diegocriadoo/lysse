<section class="section">
  <div class="container">
    <h1 class="h2 page-title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      <ul class="reviews-grid" role="list">
        {%- for article in blog.articles -%}
          <li class="review-card">
            {%- if article.image -%}
              <div class="review-card__photo"><img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="700" height="525"></div>
            {%- endif -%}
            <p class="muted" style="font-size:var(--fs-sm)">{{ article.published_at | date: '%d/%m/%Y' }}</p>
            <h2 class="h3"><a href="{{ article.url }}" style="text-decoration:none">{{ article.title }}</a></h2>
            <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
            <a class="link-arrow" href="{{ article.url }}">{{ 'blogs.read_more' | t }} {% render 'icon', name: 'arrow' %}</a>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "div", "settings": [] }
{% endschema %}
