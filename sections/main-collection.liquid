<section class="section">
  <div class="container">
    <header class="section-head section-head--left">
      <h1 class="h2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="lead rte" style="margin-top:12px">{{ collection.description }}</div>{%- endif -%}
    </header>
    {%- paginate collection.products by 12 -%}
      <ul class="product-grid" role="list">
        {%- for item in collection.products -%}
          <li>{% render 'product-card', item: item %}</li>
        {%- else -%}
          <li class="muted">{{ 'general.no_results' | t: terms: collection.title }}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Colección", "tag": "div", "settings": [] }
{% endschema %}
