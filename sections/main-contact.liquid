<section class="section">
  <div class="container page-narrow">
    <h1 class="h2 page-title">{{ page.title }}</h1>
    {%- if page.content != blank -%}<div class="rte" style="margin-bottom: 32px">{{ page.content }}</div>{%- endif -%}
    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="notice" role="status">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field"><label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ContactEmail">{{ 'contact.email' | t }}</label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="ContactBody">{{ 'contact.message' | t }}</label><textarea id="ContactBody" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
      <button type="submit" class="btn btn--primary">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Formulario de contacto", "tag": "div", "settings": [] }
{% endschema %}
