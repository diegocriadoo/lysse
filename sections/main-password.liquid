<section class="section on-dark" style="min-height:100vh;display:grid;place-items:center">
  <div class="container page-narrow" style="text-align:center">
    <p class="wordmark" style="font-size:3rem">{{ settings.wordmark | default: shop.name }}<span class="wordmark__dot">.</span></p>
    <h1 class="h2" style="margin-top:24px">{{ 'general.password_title' | t }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead" style="margin-top:16px">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'customer', style: 'max-width:420px;margin:32px auto 0' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}<p class="notice" role="status" style="color:var(--text)">{{ 'general.newsletter_success' | t }}</p>{%- endif -%}
      <div style="display:flex;gap:10px">
        <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter_email' | t }}</label>
        <input class="field" style="flex:1;min-height:52px;margin:0;padding:0 16px;border-radius:999px;border:1px solid var(--line-dark);background:transparent" id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter_email' | t }}" required>
        <button class="btn btn--primary" type="submit">{{ 'general.newsletter_submit' | t }}</button>
      </div>
    {%- endform -%}
    <details style="margin-top:48px">
      <summary style="cursor:pointer">{{ 'general.password_admin' | t }}</summary>
      {%- form 'storefront_password', style: 'display:flex;gap:10px;justify-content:center;margin-top:16px' -%}
        {%- if form.errors -%}<div class="notice notice--error">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="visually-hidden" for="Password">{{ 'general.password_label' | t }}</label>
        <input style="min-height:48px;padding:0 16px;border-radius:999px;border:1px solid var(--line-dark);background:transparent" id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'general.password_label' | t }}">
        <button class="btn btn--outline btn--sm" type="submit">{{ 'general.password_enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Contraseña", "tag": "div", "settings": [] }
{% endschema %}
