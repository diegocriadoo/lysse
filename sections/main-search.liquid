<section class="section">
  <div class="container">
    <h1 class="h2 page-title">{% if search.performed %}{{ 'general.results' | t: terms: search.terms }}{% else %}{{ 'general.search' | t }}{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="field" style="max-width:560px">
      <label for="SearchInput" class="visually-hidden">{{ 'general.search' | t }}</label>
      <div style="display:flex;gap:10px">
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
        <button class="btn btn--primary" type="submit">{{ 'general.search' | t }}</button>
      </div>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 12 -%}
        <ul class="product-grid" role="list" style="margin-top:32px">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', item: item %}
              {%- else -%}
                <a class="product-card" href="{{ item.url }}"><span class="product-card__title">{{ item.title }}</span></a>
              {%- endif -%}
            </li>
          {%- else -%}
            <li class="muted">{{ 'general.no_results' | t: terms: search.terms }}</li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Búsqueda", "tag": "div", "settings": [] }
{% endschema %}
