{%- assign r = rating | default: 0 | round -%}
<span class="stars" role="img" aria-label="{{ 'reviews.rating_label' | t: rating: rating }}">
  {%- for i in (1..5) -%}
    {%- if i <= r -%}{% render 'icon', name: 'star' %}{%- else -%}{% render 'icon', name: 'star', class: 'icon is-empty' %}{%- endif -%}
  {%- endfor -%}
</span>
