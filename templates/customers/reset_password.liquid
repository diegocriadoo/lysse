<section class="section">
  <div class="container page-narrow" style="max-width:480px">
    <h1 class="h2 page-title">{{ 'customer.reset_title' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn btn--primary btn--block" type="submit">{{ 'customer.reset_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
